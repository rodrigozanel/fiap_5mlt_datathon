      "id": "login-rate",
      "title": "Login Attempts Over Time",
      "description": "Rate of authentication attempts (success vs failure)",
      "panelTypes": "graph",
      "query": {
        "queryType": "builder",
        "promql": [],
        "builder": {
          "queryData": [
            {
              "dataSource": "metrics",
              "queryName": "A",
              "aggregateOperator": "rate",
              "aggregateAttribute": {
                "key": "auth.login.total",
                "dataType": "float64",
                "type": "Sum",
                "isColumn": false
              },
              "timeAggregation": "rate",
              "spaceAggregation": "sum",
              "filters": {"items": [], "op": "AND"},
              "expression": "A",
              "disabled": false,
              "groupBy": [
                {
                  "key": "success",
                  "dataType": "string",
                  "type": "tag",
                  "isColumn": false
                }
              ],
              "reduceTo": "last",
              "having": []
            }
          ],
          "queryFormulas": []
        },
        "clickhouse_sql": []
      }
