                "dataType": "float64",
                "type": "tag",
                "isColumn": true
              },
              "timeAggregation": "rate",
              "spaceAggregation": "sum",
              "filters": {
                "items": [
                  {
                    "key": {"key": "serviceName", "dataType": "string", "type": "tag", "isColumn": true},
                    "op": "=",
                    "value": "passos-magicos-ml"
                  },
                  {
                    "key": {"key": "kind", "dataType": "int64", "type": "tag", "isColumn": true},
                    "op": "=",
                    "value": 2
