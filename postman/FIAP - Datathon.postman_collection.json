  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Save access_token to environment\", () => {",
                  "    pm.response.to.have.status(200);",
                  "",
                  "    const body = pm.response.json();",
                  "",
                  "    const token =",
                  "        body.access_token ??",
                  "        body.token ??",
                  "        body?.data?.access_token ??",
                  "        body?.data?.token;",
                  "",
                  "    pm.expect(token, \"access token missing in response\").to.be.a(\"string\").and.not.empty;",
                  "",
                  "    pm.environment.set(\"access_token\", token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"admin\",\n    \"password\": \"passos-magicos\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseURL}}/api/v1/auth/login",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          },
          "response": []
        }
      ]
    },
